# Anivexa-API environment. Copy to .env for local dev (Bun auto-loads .env;
# with Node use `node --env-file=.env server.js`). In production set these in
# Vercel → Project → Settings → Environment Variables.

# Upstash Redis REST endpoint + token — the shared cache that stops Watch/map/
# episodes from hitting providers live on every request. Create a free database
# at https://upstash.com, then copy its REST URL and REST TOKEN here.
# Without both, the cache still runs in-memory per warm instance (no crash),
# it just can't share across serverless invocations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cache kill switch. Defaults ON. Set to "false" to bypass all caching
# (every request goes live) without removing the Upstash creds.
CACHE_ENABLED=true
